# Copy this file to .env and adjust values for your local setup.
# The app enforces a loopback-only Ollama endpoint; remote URLs are refused.
#
# IMPORTANT: .env is git-ignored. Never commit actual credentials.

# ── Ollama endpoint (must be loopback HTTP) ──────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Gemma chat model (pull with: ollama pull gemma4:e2b) ─────────────────────
# Default: gemma4:e2b (small enough for low-RAM machines such as a Raspberry Pi)
# Also accepted: gemma3n:e2b, gemma3n:e4b, gemma4:e4b
OLLAMA_MODEL=gemma4:e2b

# ── Embedding model (pull with: ollama pull nomic-embed-text) ─────────────────
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Retrieval settings ────────────────────────────────────────────────────────
# Minimum cosine similarity for a chunk to be included as evidence.
# Lower = more recall, higher = stricter (less noise).
MIN_RETRIEVAL_SIMILARITY=0.25

# Number of top chunks returned for a focused question / triage.
TOP_K_QUESTION=7
TOP_K_TRIAGE=12

# ── Document limits ───────────────────────────────────────────────────────────
MAX_FILE_MB=20
MAX_FILES=10
MAX_PAGES=1500
MAX_CHUNKS=12000

# ── Ollama context / generation limits ───────────────────────────────────────
# Reduce OLLAMA_NUM_CTX to 4096 on Raspberry Pi 4 to stay within RAM limits.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1600
REQUEST_TIMEOUT_SECONDS=300

# ── Optional: disable Ollama cloud telemetry ─────────────────────────────────
OLLAMA_NO_CLOUD=1

# ── Optional: path where Ollama stores model weights ─────────────────────────
# Set this when running the offline proof so the namespace can find models.
# OLLAMA_MODELS=/path/to/.ollama/models

# ── Verifier pass (internal safety check) ────────────────────────────────────
# Set to 0 to disable the secondary verifier pass (faster, less safe).
ENABLE_VERIFIER_PASS=1
